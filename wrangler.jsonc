// Configuratie voor de Cloudflare Worker die de app serveert en de /api-routes
// afhandelt. Zie https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluistervink",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // De Worker draait alleen voor /api/*; al het andere zijn statische
    // bestanden uit de Vite-build.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  // Workers Logs: alleen wat de Worker zelf logt (tester en pad, fouten). Geen
  // invocation logs, want die bevatten het volledige adres, en bij /api/area
  // staan daar de coördinaten in (zie de privacypagina).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Wat testers delen (wandelingen, feedback, opnames), zie /api/feedback in
  // worker/index.ts. Aangemaakt met `npx wrangler kv namespace create FEEDBACK`.
  // Lokaal (npm run dev) een eigen, lege KV: testen komt niet in productie.
  // Testers die de eigenaar vanuit de app uitnodigt (scherm Developer), zie
  // /api/testers. Aangemaakt met `npx wrangler kv namespace create TESTERS`.
  "kv_namespaces": [
    { "binding": "FEEDBACK", "id": "e7c6372ecd0f402fb1fe455a62d73f11" },
    { "binding": "TESTERS", "id": "b04f6350b8c64b26865823a93c096352" },
  ],
  // Snelheidslimiet op spraakherkenning en model, per tester (zie worker/index.ts):
  // een doorgestuurde uitnodigingslink kan zo niet in korte tijd het tegoed
  // opmaken. Een uitspraak kost 2 verzoeken, dus 60 per minuut is ruim. De
  // eigenaar (testset) telt niet mee. Zelfde namespace in beta en stabiel.
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  // Previews: een eigen versie per branch (Workers Builds draait daarvoor
  // `wrangler preview`). Leeg, want app en assets gebruiken de instellingen
  // hierboven. Previews erven géén geheimen van productie: die staan apart in
  // het dashboard onder Variables and Secrets → Previews Base.
  "previews": {},
  // Geheimen (ACCESS_CODE, OPENAI_API_KEY, ANTHROPIC_API_KEY): lokaal in
  // .dev.vars, in productie via `npx wrangler secret put <NAAM>`.
  //
  // Hierboven is de beta (branch main, op workers.dev, voor de testers).
  // Hieronder de stabiele versie op fluistervink.nl (branch stable), zie
  // docs/omgevingen.md. Bouwen met `npm run build:stable` (CLOUDFLARE_ENV kiest
  // deze omgeving). Zelfde KV, dus dezelfde testers en gedeelde feedback;
  // geheimen apart zetten met `npx wrangler secret put <NAAM> --env stable`.
  "env": {
    "stable": {
      "name": "fluistervink-stable",
      // Alleen fluistervink.nl, geen tweede adres op workers.dev: gegevens
      // zitten per adres, dus één adres per omgeving.
      "routes": [{ "pattern": "fluistervink.nl", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      // KV, snelheidslimiet en observability erven niet van boven, dus herhaald
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      "kv_namespaces": [
        { "binding": "FEEDBACK", "id": "e7c6372ecd0f402fb1fe455a62d73f11" },
        { "binding": "TESTERS", "id": "b04f6350b8c64b26865823a93c096352" },
      ],
      "ratelimits": [
        { "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
      ],
    },
  },
}
