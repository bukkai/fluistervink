# Kopieer naar .dev.vars en vul in. .dev.vars staat niet in git.
ACCESS_CODE=kies-een-lange-geheime-code
# Optioneel: codes voor testers, als JSON (naam → code)
# ACCESS_CODES={"anna":"code-van-anna"}
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Optioneel: beheersleutels voor de echte rekening op Developer (worker/billing.ts)
# OPENAI_ADMIN_KEY=sk-admin-...
# ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...

# Aanmelden zonder code (docs/plan-laagdrempelig.md); testsleutels van Turnstile die altijd slagen
INSTALL_SECRET=iets-willekeurigs
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
