{
  "name": "fluistervink",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "testset": "node scripts/testset.mjs",
    "tester": "node scripts/tester.mjs",
    "feedback": "node scripts/feedback.mjs",
    "build:stable": "CLOUDFLARE_ENV=stable vite build --mode stable",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "dexie": "^4.4.7",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
