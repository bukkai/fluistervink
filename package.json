{
  "name": "fluistervink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "testset": "node scripts/testset.mjs",
    "tester": "node scripts/tester.mjs",
    "feedback": "node scripts/feedback.mjs",
    "build:stable": "CLOUDFLARE_ENV=stable vite build --mode stable",
    "release": "git fetch origin main && git push origin origin/main:refs/heads/stable"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "dexie": "^4.4.6",
    "leaflet": "^1.9.4"
  }
}
