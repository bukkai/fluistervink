<?xml version="1.0" encoding="utf-8"?>
<!--
  Vervangt de layout van Capacitor (zelfde naam): dezelfde inhoud, maar met
  ZichtbareWebView, die zich tijdens de proef met het scherm uit "in beeld"
  blijft melden. Bij een update van Capacitor nagaan of hun layout veranderde
  (node_modules/@capacitor/android/capacitor/src/main/res/layout/).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <nl.hegmus.fluistervink.ZichtbareWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
