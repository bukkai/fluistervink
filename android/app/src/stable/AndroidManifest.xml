<?xml version="1.0" encoding="utf-8"?>
<!--
  Alleen voor de stabiele build (FLUISTERVINK_KANAAL=stable, build.gradle):
  haalt uit het manifest wat Google Play nog niet van de stabiele app mag zien.
  Wordt over src/main/AndroidManifest.xml heen gelegd.

  - Opnemen met het scherm uit (proef, docs/roadmap-android.md stap 3): het
    servicetype microfoon vraagt een verklaring in de Play Console. Tot die er
    is, alleen in de beta (interne test, niet beoordeeld). Zonder deze
    toestemming registreert MainActivity de plugin niet en ziet de webcode de
    ontwikkeloptie niet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service
            android:name=".WandelingService"
            android:foregroundServiceType="location"
            tools:replace="android:foregroundServiceType" />
    </application>

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:node="remove" />
</manifest>
